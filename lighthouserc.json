{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/about",
        "http://localhost:3100/solutions"
      ],
      "startServerCommand": "APP_ENV=test PORT=3100 node .next/standalone/server.js",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3100/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
